# MCP-Kali Configuration

# Backend selection: "docker" or "proxmox"
KALI_BACKEND=docker

# Docker settings (when KALI_BACKEND=docker)
DOCKER_SOCKET=/var/run/docker.sock
KALI_IMAGE=mcp-kali:latest

# Proxmox settings (when KALI_BACKEND=proxmox)
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_API_TOKEN_ID=root@pam!mcp-kali
PROXMOX_API_TOKEN_SECRET=xxxx-xxxx-xxxx
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY_PATH=~/.ssh/id_rsa
PROXMOX_KALI_TEMPLATE=local:vztmpl/kali-template.tar.gz
PROXMOX_TARGET_NODE=pve

# Execution settings
DEFAULT_TIMEOUT_MS=120000
LONG_RUNNING_TIMEOUT_MS=1800000
STREAM_THRESHOLD_MS=60000
